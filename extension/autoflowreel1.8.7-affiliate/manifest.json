{
  "manifest_version": 3,
  "name": "AutoFlow Reel — Bulk AI Video Automation",
  "version": "1.8.7",
  "description": "Bulk-automate AI video & image creation on Google Flow: queue prompts, storyboard, auto-run. Not affiliated with Google.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "downloads",
    "sidePanel",
    "tabs",
    "debugger",
    "webRequest",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google.com/fx/*",
    "https://labs.google/fx/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://clients6.google.com/*",
    "https://api.openai.com/*",
    "https://flowveo.nguyenduchoa.com/*",
    "https://storyboard-ai-mauve.vercel.app/*",
    "https://hiseeoptic-storyboard-ai.vercel.app/*",
    "https://storyboard.nguyenduchoa.com/*",
    "https://storyboard.aiglobal.com/*",
    "https://gen-image-wheat.vercel.app/*",
    "https://cutflow-video-studio.vercel.app/*",
    "https://member.nguyenduchoa.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://flowveo.nguyenduchoa.com/ https://storyboard.aiglobal.com/ https://storyboard-ai-mauve.vercel.app/ https://hiseeoptic-storyboard-ai.vercel.app/ https://storyboard.nguyenduchoa.com/ https://gen-image-wheat.vercel.app/ https://cutflow-video-studio.vercel.app/ http://localhost:3000/"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google.com/fx/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google.com/fx/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
